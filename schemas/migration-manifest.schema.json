{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatmangpt.com/ggen-legacy/schemas/migration-manifest.schema.json",
  "title": "ggen-legacy Migration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_head",
    "corpus_repository",
    "corpus_head",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "ggen.legacy.migration-manifest/1"
    },
    "source_repository": {
      "type": "string",
      "minLength": 1
    },
    "source_head": {
      "$ref": "#/$defs/sha1"
    },
    "corpus_repository": {
      "type": "string",
      "minLength": 1
    },
    "corpus_head": {
      "$ref": "#/$defs/sha1"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "capability_ids",
        "source_commit",
        "source_path",
        "source_digest",
        "disposition",
        "destination_path",
        "destination_digest",
        "replacement_owner",
        "migration_evidence",
        "equivalence_case",
        "verifier_report",
        "receipt"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_commit": {
          "$ref": "#/$defs/sha1"
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_digest": {
          "$ref": "#/$defs/blake3"
        },
        "disposition": {
          "enum": [
            "PRESERVED",
            "SUBSUMED",
            "REPLACED",
            "ARCHIVED",
            "REFUSED"
          ]
        },
        "destination_path": {
          "$ref": "#/$defs/relativePath"
        },
        "destination_digest": {
          "$ref": "#/$defs/blake3"
        },
        "replacement_owner": {
          "type": "string",
          "minLength": 1
        },
        "migration_evidence": {
          "$ref": "#/$defs/relativePath"
        },
        "equivalence_case": {
          "$ref": "#/$defs/relativePath"
        },
        "verifier_report": {
          "$ref": "#/$defs/relativePath"
        },
        "receipt": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
