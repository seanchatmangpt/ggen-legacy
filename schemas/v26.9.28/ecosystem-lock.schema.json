{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chatman:ggen-legacy:ecosystem-lock-schema:v26.9.28",
  "type": "object",
  "required": [
    "schema",
    "release",
    "policy",
    "components",
    "candidates"
  ],
  "properties": {
    "release": {
      "const": "v26.9.28"
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "repo",
          "sha",
          "role",
          "authority",
          "capabilities"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^seanchatmangpt/"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "sha",
          "state",
          "authority_widening"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "state": {
            "const": "CANDIDATE"
          },
          "authority_widening": {
            "const": false
          }
        }
      }
    }
  }
}
