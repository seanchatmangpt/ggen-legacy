{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanchatmangpt/ggen-legacy/schemas/final-evidence.schema.json",
  "title": "ggen Enterprise Architecture Foundry final evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_head",
    "corpus_head",
    "verifier",
    "predicates",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "ggen.enterprise-architecture-foundry.final-evidence/1"
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpus_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "predicates": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "ggen_kernel_admitted",
        "ggen_legacy_corpus_admitted",
        "unknown_capabilities",
        "unknown_dispositions",
        "unknown_standings",
        "unassigned_verifiers",
        "missing_equivalence_cases",
        "equivalence_failures",
        "replay_differences",
        "cross_repository_receipts_valid",
        "fortune_scale_reference_manufactured",
        "solution_admission",
        "standing"
      ],
      "properties": {
        "ggen_kernel_admitted": { "const": true },
        "ggen_legacy_corpus_admitted": { "const": true },
        "unknown_capabilities": { "const": 0 },
        "unknown_dispositions": { "const": 0 },
        "unknown_standings": { "const": 0 },
        "unassigned_verifiers": { "const": 0 },
        "missing_equivalence_cases": { "const": 0 },
        "equivalence_failures": { "const": 0 },
        "replay_differences": { "const": 0 },
        "cross_repository_receipts_valid": { "const": true },
        "fortune_scale_reference_manufactured": { "const": true },
        "solution_admission": { "const": true },
        "standing": { "const": "ALIVE" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "workstream-report.schema.json#/$defs/evidenceFile"
      }
    }
  }
}
