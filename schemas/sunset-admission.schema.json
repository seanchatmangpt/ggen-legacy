{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ggen.legacy.sunset.admission.v1",
  "type": "object",
  "required": [
    "schema",
    "admitted",
    "state",
    "predecessor_sha",
    "release_admission_ref",
    "replay_digest",
    "authorization_receipt_ref"
  ],
  "properties": {
    "schema": {
      "const": "ggen.legacy.sunset.admission.v1"
    },
    "admitted": {
      "type": "boolean"
    },
    "predecessor_sha": {
      "type": "string",
      "minLength": 1
    },
    "release_admission_ref": {
      "type": "string",
      "minLength": 1
    },
    "replay_digest": {
      "type": "string",
      "minLength": 1
    },
    "authorization_receipt_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
