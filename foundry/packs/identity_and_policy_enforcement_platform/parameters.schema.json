{
  "$id": "ggen://foundry/packs/identity_and_policy_enforcement_platform/parameters",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "availability_slo": {
      "maximum": 99.9999,
      "minimum": 99.0,
      "type": "number"
    },
    "compliance_profile": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "region": {
      "minLength": 1,
      "type": "string"
    },
    "scale": {
      "enum": [
        "department",
        "enterprise",
        "fortune-5"
      ]
    }
  },
  "required": [
    "region",
    "scale",
    "availability_slo",
    "compliance_profile"
  ],
  "type": "object"
}
