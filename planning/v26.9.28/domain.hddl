(define (domain ggen-legacy-v26-9-28)
  (:requirements :typing :hierarchy)
  (:types repository contract candidate)
  (:predicates
    (observed ?r - repository)
    (admitted ?c - contract)
    (planned ?c - contract)
    (manufactured ?x - candidate)
    (verified ?x - candidate)
    (receipted ?x - candidate)
    (replayed ?x - candidate)
    (released ?x - candidate)
    (refused ?x - candidate))
  (:task reconstitute :parameters (?r - repository ?c - contract ?x - candidate))
  (:method normal-route
    :parameters (?r - repository ?c - contract ?x - candidate)
    :task (reconstitute ?r ?c ?x)
    :ordered-subtasks (and
      (t1 (observe ?r))
      (t2 (admit ?c))
      (t3 (plan ?c))
      (t4 (manufacture ?c ?x))
      (t5 (verify ?x))
      (t6 (receipt ?x))
      (t7 (replay ?x))
      (t8 (release ?x))))
  (:action observe :parameters (?r - repository) :effect (observed ?r))
  (:action admit :parameters (?c - contract) :effect (admitted ?c))
  (:action plan :parameters (?c - contract) :precondition (admitted ?c) :effect (planned ?c))
  (:action manufacture :parameters (?c - contract ?x - candidate) :precondition (planned ?c) :effect (manufactured ?x))
  (:action verify :parameters (?x - candidate) :precondition (manufactured ?x) :effect (verified ?x))
  (:action receipt :parameters (?x - candidate) :precondition (verified ?x) :effect (receipted ?x))
  (:action replay :parameters (?x - candidate) :precondition (receipted ?x) :effect (replayed ?x))
  (:action release :parameters (?x - candidate) :precondition (replayed ?x) :effect (released ?x))
)
