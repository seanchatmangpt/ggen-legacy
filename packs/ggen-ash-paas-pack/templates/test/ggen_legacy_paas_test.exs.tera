defmodule {{ moduleName }}Test do
  use ExUnit.Case, async: true

  test "Ash resource closure emits deterministic public-ontology-aligned TTL" do
    assert {:ok, first} = {{ moduleName }}.SemanticProjection.compile_ash_bundle()
    assert {:ok, second} = {{ moduleName }}.SemanticProjection.compile_ash_bundle()
    assert first.status == :PARTIAL_ALIVE
    assert first.standing == :construct_only
    assert first.files == second.files
    assert first.sha256 == second.sha256

    ontology = first.files["ontology.ttl"]
    assert ontology =~ "{{ serviceClass }}"
    assert ontology =~ "{{ instanceClass }}"
    assert ontology =~ "{{ deploymentClass }}"
    assert ontology =~ "{{ receiptClass }}"
    assert ontology =~ "{{ policyClass }}"
    assert ontology =~ "{{ quantityClass }}"
  end

  test "AshR2RML Reactor pipeline executes against exact generated resource closure" do
    assert {:ok, r2rml} = {{ moduleName }}.SemanticProjection.compile_reactor_mapping()
    assert r2rml =~ "rr:TriplesMap"
  end

  test "SELECT is deterministic and non-actuating" do
    candidates = [
      %{id: "b", priority: 1},
      %{id: "a", priority: 2},
      %{id: "c", priority: 1}
    ]

    assert Enum.map({{ moduleName }}.ControlPlane.select(candidates), & &1.id) == ["a", "b", "c"]
  end

  test "provisioning DO becomes ALIVE only through a bound BRCE receipt" do
    request = %{
      admitted?: true,
      service_instance_id: "service-instance:test",
      blueprint_id: "blueprint:test",
      authority: "test-authority",
      idempotency_key: "idem:test"
    }

    assert {:ok, receipt} = Reactor.run({{ moduleName }}.ProvisionReactor, %{
      request: request,
      brce: {{ moduleName }}.TestBRCE,
      context: %{}
    })

    assert receipt.standing == :ALIVE
    assert receipt.subject == "service-instance:test"
    assert receipt.observed_operation == :provision
    assert is_binary(receipt.intent_digest)
  end

  test "unbound receipt is refused" do
    request = %{admitted?: true, service_instance_id: "service-instance:test"}

    assert {:error, _reason} = Reactor.run({{ moduleName }}.ProvisionReactor, %{
      request: request,
      brce: {{ moduleName }}.UnboundBRCE,
      context: %{}
    })
  end

  test "ODRL and semantic inputs do not confer DO authority" do
    contract = {{ moduleName }}.SemanticContract.authority_model()
    refute contract.odrl_is_execution_authority?
    assert contract.brce_required?
    refute contract.request_time_ggen?
  end
end
